# DreamChaser Agent 环境变量配置模板
# 使用说明：复制本文件，重命名为 .env，填入真实密钥，不要提交 .env 到 git
# .env 已经加入 .gitignore，避免密钥泄露

# 大语言模型配置
LLM_API_KEY=<填入你的大语言模型的API_KEY>
LLM_MODEL_NAME=<填入你的模型名称>
LLM_BASE_URL=https://api.deepseek.com

# 重试配置（Tenacity 退避重试最大重试次数）
MAX_RETRIES=5

# 联网搜索工具 SERPAPI
SERPAPI_API_KEY=<填入你的serpapi的API_KEY>